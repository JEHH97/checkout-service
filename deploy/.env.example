# Copy to deploy/.env and replace every CHANGE_ME value with a unique value.
# Generate secrets with: openssl rand -hex 32
CHECKOUT_VERSION=v1.0.1
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3001
POSTGRES_USER=checkout
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
DATABASE_URL=postgresql://checkout:CHANGE_ME_generate_with_openssl_rand_hex_32@postgres:5432/checkout?schema=public
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
REDIS_URL=redis://:CHANGE_ME_generate_with_openssl_rand_hex_32@redis:6379/1
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=1h
PAYMENT_ADAPTER=fake
DEMO_MODE=true
RUN_DB_PUSH=true
RUN_SEED=true
TRUST_PROXY_HOPS=1
