{
  "name": "checkout-service",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "A resilient orders and payments API built with NestJS",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "scripts/in-dev nest start",
    "start:dev": "scripts/in-dev nest start --watch",
    "start:prod": "scripts/in-dev node dist/main.js",
    "worker": "scripts/in-dev node dist/worker.js",
    "seed": "scripts/in-dev tsx prisma/seed.ts",
    "prisma:generate": "scripts/in-dev prisma generate",
    "prisma:migrate": "scripts/in-dev prisma migrate deploy",
    "lint": "scripts/in-dev eslint \"{src,test,prisma}/**/*.ts\"",
    "format": "scripts/in-dev prettier --write .",
    "format:check": "scripts/in-dev prettier --check .",
    "typecheck": "scripts/in-dev tsc --noEmit",
    "test:unit": "scripts/in-dev jest --config jest.config.cjs --selectProjects unit --coverage",
    "test:integration": "export DATABASE_URL=${DATABASE_URL:-postgresql://checkout:checkout@localhost:5433/checkout?schema=public} REDIS_URL=${REDIS_URL:-redis://localhost:6380}; scripts/in-dev prisma db push && scripts/in-dev jest --config jest.config.cjs --selectProjects integration --runInBand",
    "test:e2e": "export DATABASE_URL=${DATABASE_URL:-postgresql://checkout:checkout@localhost:5433/checkout?schema=public} REDIS_URL=${REDIS_URL:-redis://localhost:6380}; scripts/in-dev jest --config jest.config.cjs --selectProjects e2e --runInBand",
    "build": "scripts/in-dev nest build",
    "scan": "scripts/in-dev node scripts/scan-forbidden.mjs",
    "check": "scripts/in-dev npm run lint && scripts/in-dev npm run format:check && scripts/in-dev npm run typecheck && scripts/in-dev npm run test:unit && scripts/in-dev npm run test:integration && scripts/in-dev npm run test:e2e && scripts/in-dev npm run build && scripts/in-dev npm run scan",
    "check:quick": "scripts/in-dev npm run lint && scripts/in-dev npm run typecheck && scripts/in-dev npm run test:unit && scripts/in-dev npm run build && scripts/in-dev npm run scan"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@types/bcrypt": "5.0.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.5",
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
